<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Invoice {{ invoice.invoice_number }} · {{ invoice["from"].name }}</title>
<meta name="author" content="{{ invoice['from'].name }}">
<link rel="stylesheet" href="invoice.css">
</head>
<body>

<header class="masthead">
  <div class="issuer">
    <div class="issuer-name">{{ invoice["from"].name }}</div>
    {% for line in invoice["from"].address %}
    <div>{{ line }}</div>
    {% endfor %}
    {% if invoice["from"].get("email") %}
    <div>{{ invoice["from"].email }}</div>
    {% endif %}
  </div>
  <div class="doc-id">
    <div class="doc-type">Invoice</div>
    <div class="doc-number">No. {{ invoice.invoice_number }}</div>
  </div>
</header>

<section class="overview">
  <div class="bill-to">
    <div class="label">Bill to</div>
    <div class="strong">{{ invoice.billed_to.name }}</div>
    {% for line in invoice.billed_to.address %}
    <div>{{ line }}</div>
    {% endfor %}
  </div>
  <dl class="facts">
    <div><dt>Issued</dt><dd>{{ format_date(invoice.date_of_issue) }}</dd></div>
    <div><dt>Due</dt><dd>{{ format_date(invoice.due_date) }}</dd></div>
    <div><dt>Service period</dt><dd>{{ format_service_period(invoice.service_month) }}</dd></div>
    {% if invoice.get("purchase_order") %}
    <div><dt>PO number</dt><dd>{{ invoice.purchase_order }}</dd></div>
    {% endif %}
  </dl>
  <div class="amount-due">
    <div class="label">Amount due</div>
    <div class="amount">{{ format_money(total, invoice.currency, with_code=True) }}</div>
    <div class="by">by {{ format_date(invoice.due_date) }}</div>
  </div>
</section>

<table class="items">
  <thead>
    <tr>
      <th>Description</th>
      <th class="num">Qty</th>
      <th class="num">Rate</th>
      <th class="num">Amount</th>
    </tr>
  </thead>
  <tbody>
    {% for item in invoice.line_items %}
    <tr>
      <td>{{ item.description }}</td>
      <td class="num">{{ format_number(item.qty) }}</td>
      <td class="num">{{ format_money(item.unit_cost, invoice.currency) }}</td>
      <td class="num">{{ format_money(item.unit_cost * item.qty, invoice.currency) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<table class="totals">
  <tr><td>Subtotal</td><td class="num">{{ format_money(subtotal, invoice.currency) }}</td></tr>
  {% if invoice.tax_rate %}
  <tr><td>Tax ({{ format_number(invoice.tax_rate) }}%)</td><td class="num">{{ format_money(tax, invoice.currency) }}</td></tr>
  {% endif %}
  {% if invoice.shipping %}
  <tr><td>Shipping</td><td class="num">{{ format_money(invoice.shipping, invoice.currency) }}</td></tr>
  {% endif %}
  <tr class="grand"><td>Total due</td><td class="num">{{ format_money(total, invoice.currency, with_code=True) }}</td></tr>
</table>

<section class="payment">
  <div class="bank">
    <div class="label">Payment details</div>
    <dl class="grid">
      <dt>Beneficiary</dt><dd>{{ invoice.bank_details.name }}</dd>
      <dt>Bank</dt><dd>{{ invoice.bank_details.bank_name }}<br>{{ invoice.bank_details.bank_address | join(", ") }}</dd>
      <dt>Account number</dt><dd>{{ invoice.bank_details.account_number }} <span class="muted">({{ invoice.bank_details.account_type }})</span></dd>
      <dt>Routing (ACH &amp; wire)</dt><dd>{{ invoice.bank_details.routing_number }}</dd>
      <dt>SWIFT / BIC</dt><dd>{{ invoice.bank_details.swift_bic }}</dd>
    </dl>
  </div>
  {% if invoice.terms %}
  <div class="terms">{{ invoice.terms }}</div>
  {% endif %}
</section>

<footer>{{ invoice["from"].name }} · Invoice {{ invoice.invoice_number }}</footer>

</body>
</html>
